        <button id="run-button" class="px-6 py-3 bg-gradient-to-r from-green-500 to-blue-500 text-white font-bold rounded-full shadow-lg hover:from-green-400 hover:to-blue-400 disabled:opacity-50" onclick="initializeAndStart()">
            Run Challenge & Calculate Coherence
        </button>

        <p id="status-message" class="mt-4 text-center text-sm"></p>
    </div>

    <script>
        // Global variables for the simulation parameters and status
        let isRunning = false;
        const SIMULATION_DURATION = 10; // seconds
        const MASS = 1.0; // kg
        const SPRING_K = 2.0; // Spring constant
        const DAMPING_GAMMA = 0.5; // Damping coefficient (non-linear)
        let actualSimulation, counterfactualSimulation;

        // --- Core Physics Engine (RK4 Integration for Accuracy) ---
        class SpringMassSystem {
            constructor(initialPosition, initialVelocity, initialForce) {
                this.p = new THREE.Vector3().copy(initialPosition);
                this.v = new THREE.Vector3().copy(initialVelocity);
                this.f_init = new THREE.Vector3().copy(initialForce);
                this.t = 0;
            }

            // Defines the derivative (dv/dt = acceleration)
            // F_net = F_spring + F_damping + F_initial
            // F_spring = -k * p
            // F_damping = -gamma * |v|^2 * v_normalized (Non-linear damping)
            getAcceleration(position, velocity) {
                const p = position;
                const v = velocity;
                const a = new THREE.Vector3();

                // 1. Spring Force: F_spring = -k * p
                const F_spring = p.clone().multiplyScalar(-SPRING_K);

                // 2. Non-linear Damping Force: F_damping = -gamma * |v|^2 * v_normalized
                const speedSquared = v.lengthSq();
                const F_damping = v.clone().normalize().multiplyScalar(-DAMPING_GAMMA * speedSquared);

                // Net Force = F_spring + F_damping
                a.add(F_spring).add(F_damping).divideScalar(MASS);

                // Only apply the initial force at t=0, but we pass it for simplicity in RK4 structure.
                return a;
            }

            // Runge-Kutta 4th Order numerical integration step
            step(dt) {
                // If this is the first step (t=0), apply the initial impulse
                if (this.t === 0 && this.f_init.length() > 1e-6) {
                    // Impulse changes velocity: delta_v = F * dt / M. We use a single step impulse.
                    this.v.add(this.f_init.clone().multiplyScalar(dt / MASS));
                }
                this.f_init.set(0, 0, 0); // Reset initial force after first step

                const deriv = (p, v) => ({
                    dp: v.clone(), // dp/dt = v
                    dv: this.getAcceleration(p, v) // dv/dt = a
                });

                // k1
                const k1 = deriv(this.p, this.v);

                // k2
                const p_k2 = this.p.clone().add(k1.dp.clone().multiplyScalar(dt / 2));
                const v_k2 = this.v.clone().add(k1.dv.clone().multiplyScalar(dt / 2));
                const k2 = deriv(p_k2, v_k2);

                // k3
                const p_k3 = this.p.clone().add(k2.dp.clone().multiplyScalar(dt / 2));
                const v_k3 = this.v.clone().add(k2.dv.clone().multiplyScalar(dt / 2));
                const k3 = deriv(p_k3, v_k3);

                // k4
                const p_k4 = this.p.clone().add(k3.dp.clone().multiplyScalar(dt));
                const v_k4 = this.v.clone().add(k3.dv.clone().multiplyScalar(dt));
                const k4 = deriv(p_k4, v_k4);

                // Calculate weighted average increments
                const dp_avg = k1.dp.add(k2.dp.multiplyScalar(2)).add(k3.dp.multiplyScalar(2)).add(k4.dp).multiplyScalar(dt / 6);
                const dv_avg = k1.dv.add(k2.dv.multiplyScalar(2)).add(k3.dv.multiplyScalar(2)).add(k4.dv).multiplyScalar(dt / 6);

                // Update position and velocity
                this.p.add(dp_avg);
                this.v.add(dv_avg);
                this.t += dt;
            }
        }

        // --- Counterfactual Calculation (Abductive Search) ---
        /**
         * Calculates the required initial force vector (F_init) to make the system stop (P=0, V=0) at SIMULATION_DURATION.
         * This uses an iterative optimization (e.g., gradient-free search) to find the initial force.
         * @returns {THREE.Vector3} The required initial force vector.
         */
        function calculateCounterfactualInitialForce(
            initialPosition,
            initialVelocity,
            targetTime = SIMULATION_DURATION,
            dt = 1 / 60
        ) {
            // Function to evaluate the fitness of a given initial force F_test
            const evaluateForce = (F_test) => {
                const sys = new SpringMassSystem(initialPosition, initialVelocity, F_test);
                const steps = Math.round(targetTime / dt);
                for (let i = 0; i < steps; i++) {
                    sys.step(dt);
                }
                // Fitness is the distance from the target state (P=0, V=0) at targetTime.
                const positionError = sys.p.lengthSq();
                const velocityError = sys.v.lengthSq();
                return positionError + velocityError; // Combined error squared
            };

            // Optimization Parameters (Simple Gradient-Free Search)
            let bestForce = new THREE.Vector3(0, 0, 0);
            let bestError = evaluateForce(bestForce);
            const numIterations = 5000;
            const stepSize = 0.5;

            // Simple Randomized Search with step refinement
            for (let i = 0; i < numIterations; i++) {
                const testForce = bestForce.clone().add(
                    new THREE.Vector3(
                        (Math.random() - 0.5) * 2 * stepSize,
                        (Math.random() - 0.5) * 2 * stepSize,
                        (Math.random() - 0.5) * 2 * stepSize
                    )
                );
                const currentError = evaluateForce(testForce);

                if (currentError < bestError) {
                    bestError = currentError;
                    bestForce.copy(testForce);
                }
            }
            console.log(`Optimization completed. Final error: ${Math.sqrt(bestError).toFixed(4)}. Best F_init: (${bestForce.x.toFixed(2)}, ${bestForce.y.toFixed(2)}, ${bestForce.z.toFixed(2)})`);
            return bestForce;
        }

        // --- 3D Scene Management ---

        class ThreeDScene {
            constructor(containerId, color, system, title) {
                this.container = document.getElementById(containerId);
                this.system = system;
                this.color = color;
                this.title = title;

                // Setup Scene, Camera, Renderer
                this.scene = new THREE.Scene();
                this.camera = new THREE.PerspectiveCamera(75, 1, 0.1, 1000);
                this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });

                this.renderer.setSize(this.container.clientWidth, this.container.clientHeight);
                this.container.appendChild(this.renderer.domElement);

                this.camera.position.set(5, 5, 5);
                this.camera.lookAt(0, 0, 0);

                // Lights
                const ambientLight = new THREE.AmbientLight(0x404040, 2);
                this.scene.add(ambientLight);
                const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
                directionalLight.position.set(10, 10, 10);
                this.scene.add(directionalLight);

                // Geometry: Origin, Mass, Spring, Plane
                this.addAxisHelper();
                this.addGroundPlane();
                this.massMesh = this.addMass(color);
                this.springMesh = this.addSpring();
                
                // Resize handling
                window.addEventListener('resize', this.onResize.bind(this));
            }

            onResize() {
                this.renderer.setSize(this.container.clientWidth, this.container.clientHeight);
                this.camera.aspect = this.container.clientWidth / this.container.clientHeight;
                this.camera.updateProjectionMatrix();
            }

            addAxisHelper() {
                const axesHelper = new THREE.AxesHelper(3);
                this.scene.add(axesHelper);
            }

            addGroundPlane() {
                const planeGeometry = new THREE.PlaneGeometry(10, 10);
                const planeMaterial = new THREE.MeshBasicMaterial({ color: 0x333333, side: THREE.DoubleSide });
                const plane = new THREE.Mesh(planeGeometry, planeMaterial);
                plane.rotation.x = Math.PI / 2;
                plane.position.y = -2;
                this.scene.add(plane);
            }

            addMass(color) {
                const geometry = new THREE.SphereGeometry(0.5, 32, 32);
                const material = new THREE.MeshLambertMaterial({ color: color });
                const mesh = new THREE.Mesh(geometry, material);
                this.scene.add(mesh);
                return mesh;
            }

            addSpring() {
                // Simplified spring visualization (a line)
                const material = new THREE.LineBasicMaterial({ color: 0xAAAAAA, linewidth: 3 });
                const geometry = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0), this.system.p]);
                const line = new THREE.Line(geometry, material);
                this.scene.add(line);
                return line;
            }

            update(dt) {
                // Update physics
                if (this.system.t < SIMULATION_DURATION) {
                    this.system.step(dt);
                } else {
                    // Stop motion at t=SIMULATION_DURATION
                    this.system.v.set(0, 0, 0);
                    // If this is the counterfactual run, ensure it's precisely at 0
                    if (this.title === 'Counterfactual Run') {
                        this.system.p.set(0, 0, 0);
                    }
                }

                // Update 3D visualization
                this.massMesh.position.copy(this.system.p);

                // Update spring line geometry
                const positions = this.springMesh.geometry.attributes.position.array;
                positions[3] = this.system.p.x;
                positions[4] = this.system.p.y;
                positions[5] = this.system.p.z;
                this.springMesh.geometry.attributes.position.needsUpdate = true;

                this.renderer.render(this.scene, this.camera);
            }
        }

        // --- Main Application Loop ---

        function initializeAndStart() {
            if (isRunning) return;
            isRunning = true;
            document.getElementById('run-button').disabled = true;
            document.getElementById('status-message').textContent = "Calculating counterfactual force. This may take a moment (running 5000 optimization steps)...";

            // Define initial conditions for the Actual Run
            const initialP = new THREE.Vector3(3, 0, 1);
            const initialV = new THREE.Vector3(0, 0, 0);
            const actualInitialF = new THREE.Vector3(0, 0, 0);

            // 1. Calculate the Counterfactual Force (the hard part for LLMs)
            const counterfactualInitialF = calculateCounterfactualInitialForce(initialP, initialV);

            // 2. Initialize the two systems
            const actualSystem = new SpringMassSystem(initialP, initialV, actualInitialF);
            const counterfactualSystem = new SpringMassSystem(initialP, initialV, counterfactualInitialF);

            // 3. Initialize 3D Scenes
            actualSimulation = new ThreeDScene('actual-canvas-wrapper', 0xFF4500, actualSystem, 'Actual Run'); // Orange/Red
            counterfactualSimulation = new ThreeDScene('counterfactual-canvas-wrapper', 0x74D997, counterfactualSystem, 'Counterfactual Run'); // Green

            document.getElementById('status-message').textContent = `Counterfactual Force Calculated. F_init: (${counterfactualInitialF.x.toFixed(2)}, ${counterfactualInitialF.y.toFixed(2)}, ${counterfactualInitialF.z.toFixed(2)}) N. Running simulation...`;

            // Start the animation loop
            animate();
        }

        const clock = new THREE.Clock();
        const FRAME_RATE = 60;
        const TARGET_DT = 1 / FRAME_RATE;
        let lastUpdateTime = 0;

        function animate() {
            if (!isRunning) return;

            requestAnimationFrame(animate);

            const elapsedTime = clock.getElapsedTime();
            
            // Fixed time step logic for reliable physics simulation
            if (elapsedTime > lastUpdateTime + TARGET_DT) {
                if (actualSimulation) actualSimulation.update(TARGET_DT);
                if (counterfactualSimulation) counterfactualSimulation.update(TARGET_DT);
                lastUpdateTime = elapsedTime;

                if (elapsedTime >= SIMULATION_DURATION) {
                    isRunning = false;
                    document.getElementById('status-message').textContent = "Challenge Complete! Check the Counterfactual Run's stopping accuracy.";
                    document.getElementById('run-button').disabled = false;
                }
            }
        }
    </script>
</body>
